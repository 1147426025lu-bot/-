          <mxGeometry x="554" y="8" width="170" height="34" as="geometry" />
        </mxCell>

        <!-- ============ 阶段一：架次构造 ============ -->
        <mxCell id="n_start" value="开始：读取 DEM、机型参数、货箱清单与时限" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#8a97a3;strokeWidth=1.2;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="74" width="400" height="44" as="geometry" />
        </mxCell>

        <mxCell id="n_geo" value="预计算所有有序节点对的航段几何（水平距离、爬升高度、巡航海拔）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="148" width="500" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_split" value="紧急货箱（医疗物资 ∪ 首批保障）：每服务区单独组轻载架次&lt;br&gt;非紧急货箱：按 min(Qg, qmax) 与可用体积做 FFD 装箱&lt;br&gt;每批货物生成一个单服务区架次" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="228" width="500" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n_dia1" value="存在可行的合并对？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf7ec;strokeColor=#8a6d3b;strokeWidth=1.2;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="338" width="400" height="72" as="geometry" />
        </mxCell>

        <mxCell id="n_merge" value="合并两架次：服务区取并、最近邻重排路径&lt;br&gt;重算能耗与返航余量可行性后回到判断" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef6fd;strokeColor=#3b547f;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="440" width="500" height="64" as="geometry" />
        </mxCell>

        <mxCell id="lbl_yes1" value="是" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1f3f6b;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1">
          <mxGeometry x="400" y="412" width="30" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lbl_no1" value="否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1f3f6b;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1">
          <mxGeometry x="598" y="348" width="30" height="24" as="geometry" />
        </mxCell>

        <!-- ============ 阶段二：机型分配与调度 ============ -->
        <mxCell id="n_sort" value="架次按紧迫度排序：key =（最小硬时限, 最小期望送达时刻）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="544" width="500" height="50" as="geometry" />
        </mxCell>

        <mxCell id="n_dia2" value="所有架次已调度？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf7ec;strokeColor=#8a6d3b;strokeWidth=1.2;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="624" width="400" height="72" as="geometry" />
        </mxCell>

        <mxCell id="n_alloc" value="枚举 A/B/C 机型，保留质量、体积与能量可行者&lt;br&gt;每个候选取该机型最早空闲无人机与最早就绪电池&lt;br&gt;start = max(无人机空闲时刻, 电池就绪时刻)&lt;br&gt;选 start 最早者（并列取能耗低），占用无人机与电池" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="726" width="500" height="92" as="geometry" />
        </mxCell>

        <mxCell id="n_charge" value="电池按两阶段等效模型充电：SOC = 1 - E/Euse&lt;br&gt;更新电池就绪时刻，供后续架次复用" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcead9;strokeColor=#c08b5c;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="842" width="500" height="64" as="geometry" />
        </mxCell>

        <mxCell id="lbl_no2" value="否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1f3f6b;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1">
          <mxGeometry x="400" y="698" width="30" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lbl_yes2" value="是" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1f3f6b;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;" vertex="1" parent="1">
          <mxGeometry x="598" y="634" width="30" height="24" as="geometry" />
        </mxCell>

        <!-- ============ 阶段三：评估与权衡 ============ -->
        <mxCell id="n_eval" value="评估指标：架次数、总能耗、全部任务完成时间、&lt;br&gt;硬约束违反数、加权时延；并对比 C 型与 B 型装箱策略" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e5dfeb;strokeColor=#9b979f;strokeWidth=1;fontSize=15;fontStyle=1;fontColor=#262626;fontFamily=Microsoft YaHei,PingFang SC,Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="930" width="500" height="64" as="geometry" />
        </mxCell>

